@page "/admin"
@attribute [Authorize(Roles = Roles.Admin)]
@inject ApiClient Api

<PageTitle>@L["Manage cards — Mark’s Baseball Cards"]</PageTitle>
<section class="workspace container-width inventory-workspace">
    <div class="workspace-heading">
        <div><h1>@L["Manage cards"]</h1><p>@L["Photographs, descriptions and availability in one place."]</p></div>
        <button class="button button-primary" disabled="@_busy" @onclick="StartCreate"><Icon Name="plus" Size="18" /> @L["Add a card"]</button>
    </div>
    @if (_message is not null)
    {
        <div class="inline-notice @(_isError ? "notice-error" : "")" role="status"><span>@L[_message]</span><button class="icon-button" aria-label="@L["Dismiss message"]" @onclick="() => _message = null"><Icon Name="close" /></button></div>
    }
    @if (_photosId is { } photoId)
    {
        <PhotoOnboarding @key="photoId" CardId="photoId" Changed="LoadAsync" Close="() => _photosId = null" />
    }
    @if (_editing is not null)
    {
        <div class="workspace-panel card-editor">
            <div class="panel-heading"><h2>@L[_editingId is null ? "Add a card" : "Edit card details"]</h2><button class="icon-button" aria-label="@L["Close editor"]" disabled="@_busy" @onclick="CancelEdit"><Icon Name="close" /></button></div>
            <EditForm Model="_editing" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <fieldset disabled="@_busy">
                    <div class="card-editor-main">
                        <div class="card-editor-fields">
                            <div class="card-editor-identity">
                                <div><label class="form-label" for="card-number">@L["Card number"]</label><InputText id="card-number" class="form-control" maxlength="20" @bind-Value="_editing.CardNumber" /><LocalizedValidationMessage For="() => _editing.CardNumber" /></div>
                                <div><label class="form-label" for="player-name">@L["Player name"]</label><InputText id="player-name" class="form-control" maxlength="120" @bind-Value="_editing.PlayerName" /><LocalizedValidationMessage For="() => _editing.PlayerName" /></div>
                            </div>
                            <div><label class="form-label" for="card-description">@L["Description"]</label><InputTextArea id="card-description" class="form-control" rows="4" maxlength="2000" @bind-Value="_editing.Description" /><LocalizedValidationMessage For="() => _editing.Description" /></div>
                            <div><label class="form-label" for="card-condition">@L["Condition"]</label><InputText id="card-condition" class="form-control" @bind-Value="_editing.Condition" maxlength="60" /></div>
                        </div>
                        <div>
                            <CardPhotoSelection @key="_selectionKey" Available="@(CardPhotoLimits.MaxPhotos - _editorPhotoCount)" Busy="_busy" Changed="files => _selectedPhotos = files" />
                            @if (_editorPhotoCount > 0) { <p class="small-note">@L.Format("{0} photos already saved", _editorPhotoCount)</p> }
                        </div>
                    </div>
                    <details class="editor-options">
                        <summary>@L["Collection details"]</summary>
                        <div class="field-grid">
                            <div><label class="form-label" for="doubles">@L["Doubles"]</label><InputNumber id="doubles" class="form-control" @bind-Value="_editing.Doubles" /><LocalizedValidationMessage For="() => _editing.Doubles" /></div>
                            <div class="field-wide"><span class="form-label">@L["Filing sets"]</span><div class="checkbox-group">@for (var i = 1; i <= 6; i++) { var n = i; <label><input type="checkbox" checked="@GetSet(n)" @onchange="e => SetSet(n, (bool)e.Value!)" /> @L.Format("Set {0}", n)</label> }</div></div>
                            <div class="field-full"><div class="checkbox-group"><label><input type="checkbox" @bind="_editing.InPlastic" /> @L["In plastic"]</label><label><input type="checkbox" @bind="_editing.IsRookie" /> @L["Rookie"]</label><label><input type="checkbox" @bind="_editing.IsRoyals" /> @L["Royals"]</label></div></div>
                        </div>
                    </details>
                    @if (_editingId is not null)
                    {
                        <details class="editor-options">
                            <summary>@L["Publication and sale"]</summary>
                            <div class="field-grid">
                                <div><label class="checkbox-label"><input type="checkbox" @bind="_editing.IsPublished" /> @L["Published in the collection"]</label></div>
                                <div><label class="checkbox-label"><input type="checkbox" @bind="_editing.IsForSale" disabled="@(!_editing.IsPublished)" /> @L["List in marketplace"]</label></div>
                                <div><label class="form-label" for="card-price">@L["Price (USD)"]</label><InputNumber id="card-price" class="form-control" @bind-Value="_editing.Price" step="0.01" /><LocalizedValidationMessage For="() => _editing.Price" /></div>
                                <div class="field-full"><label class="form-label" for="listing-notes">@L["Listing notes"]</label><InputTextArea id="listing-notes" class="form-control" @bind-Value="_editing.ListingNotes" rows="2" maxlength="500" /></div>
                            </div>
                        </details>
                    }
                    <div class="form-actions">
                        <button class="button button-primary" type="submit">@L[_busy ? "Saving..." : "Save card"]</button>
                        <button class="button button-outline" type="button" @onclick="CancelEdit">@L["Cancel"]</button>
                        <span class="small-note">@L["Saved privately until you publish."]</span>
                    </div>
                    @if (_busy) { <p class="small-note" role="status">@_savingProgress</p> }
                </fieldset>
            </EditForm>
        </div>
    }
    <div class="browse-toolbar">
        <div class="search-field"><Icon Name="search" /><input type="search" maxlength="100" aria-label="@L["Search inventory by player or card number"]" placeholder="@L["Find a card in the inventory..."]" @bind="_search" @bind:event="oninput" @bind:after="FilterChanged" /></div>
        <div class="toolbar-right"><label class="sr-only" for="inventory-status">@L["Filter by status"]</label><select id="inventory-status" @bind="_status" @bind:after="FilterChanged"><option value="all">@L["All inventory"]</option><option value="draft">@L["Draft"]</option><option value="listed">@L["For sale"]</option><option value="sold">@L["Sold"]</option><option value="collection">@L["Collection only"]</option></select><button class="icon-button" disabled="@_loading" aria-label="@L["Refresh inventory"]" @onclick="LoadAsync"><Icon Name="refresh" /></button></div>
    </div>
    @if (_loading) { <div class="empty-state" role="status">@L["Loading inventory..."]</div> }
    else if (_loadFailed) { <div class="empty-state"><h2>@L["The inventory couldn’t load."]</h2><button class="button button-primary" @onclick="LoadAsync">@L["Try again"]</button></div> }
    else if (_cards.Count == 0) { <div class="empty-state"><h2>@L["No cards to show."]</h2><p>@L["Add the first card to start this inventory."]</p></div> }
    else
    {
        <div class="data-table-shell"><table class="data-table">
            <caption>@L["Live inventory. “Filed” counts the six filing sets for each record. Displayed prices are in USD."]</caption>
            <thead><tr><th>@L["Card"]</th><th>@L["Player"]</th><th>@L["Status"]</th><th>@L["Photos"]</th><th>@L["Price"]</th><th>@L["Actions"]</th></tr></thead>
            <tbody>@foreach (var card in _cards)
            {
                <tr @key="card.Id"><td>#@card.CardNumber</td><td class="player-cell">@card.PlayerName</td><td>@L[!card.IsPublished ? "Draft" : card.IsSold ? "Sold" : card.IsForSale ? "For sale" : "Collection"]</td><td>@card.PhotoCount / 6</td><td>@L.Usd(card.Price, "Not set")</td>
                    <td><div class="table-actions"><button class="table-action" disabled="@_busy" @onclick="() => StartEdit(card)">@L["Edit"]</button><button class="table-action" disabled="@_busy" @onclick="() => StartPhotos(card.Id)">@L["Photos"]</button>@if (!card.IsSold) { <button class="table-action" disabled="@_busy" @onclick="() => ConfirmAsync(card, false)">@L["Mark sold"]</button> }<button class="table-action danger" disabled="@_busy" @onclick="() => ConfirmAsync(card, true)">@L["Delete"]</button></div></td>
                </tr>
            }</tbody>
        </table></div>
    }
    <Pagination Page="_page" Pages="_pages" Total="_total" Busy="_loading" Changed="ChangePage" />
</section>
<Modal @ref="_confirmation" Title="@L["Confirm inventory change"]">
    @if (_pending is { } pending)
    {
        <div class="confirm-body"><h2>@L[_deletePending ? "Remove this record?" : "Record this sale?"]</h2><p>#@pending.CardNumber · @pending.PlayerName</p><p>@L[_deletePending ? "This removes the record and all its photographs." : "The card will be marked as sold and removed from available listings."]</p><div class="form-actions"><button class="button button-outline" @onclick="() => _confirmation!.CloseAsync()">@L["Keep as is"]</button><button class="button button-primary" disabled="@_busy" @onclick="ApplyConfirmedAsync">@L["Confirm"]</button></div></div>
    }
</Modal>
@code {
    private List<CardDto> _cards = [];
    private string _search = "", _status = "all";
    private int _page = 1, _pages = 1, _total, _requestId;
    private bool _loading = true, _loadFailed, _busy, _isError, _deletePending;
    private string? _message;
    private CardUpsertDto? _editing;
    private int? _editingId, _photosId;
    private CardDto? _pending;
    private Modal? _confirmation;
    private CancellationTokenSource? _load;
    private readonly CancellationTokenSource _life = new();
    private IReadOnlyList<IBrowserFile> _selectedPhotos = [];
    private int _selectionKey, _editorPhotoCount;
    private string _savingProgress = "";
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private Task LoadAsync() => LoadPage(_page);
    private Task ChangePage(int page) => LoadPage(page);
    private Task FilterChanged() => LoadPage(1, true);
    private async Task LoadPage(int page, bool debounce = false)
    {
        _load?.Cancel(); _load?.Dispose(); _load = new();
        var ct = _load.Token; var request = ++_requestId; _page = page; _loading = true; _loadFailed = false;
        try
        {
            if (debounce) await Task.Delay(350, ct);
            var data = await Api.GetCardsPageAsync(_search, _status, page, ct) ?? new();
            if (request != _requestId) return;
            _cards = data.Items; _total = data.TotalCount; _pages = data.TotalPages;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException) { if (request == _requestId) _loadFailed = true; }
        finally { if (request == _requestId) _loading = false; }
    }
    private void StartCreate() { _photosId = null; _editing = new(); _editingId = null; _message = null; _selectedPhotos = []; _editorPhotoCount = 0; _selectionKey++; }
    private void StartEdit(CardDto card) { _photosId = null; _editingId = card.Id; _message = null; _editing = ApiClient.Editable(card); _selectedPhotos = []; _editorPhotoCount = card.PhotoCount; _selectionKey++; }
    private void CancelEdit() { _editing = null; _editingId = null; _selectedPhotos = []; }
    private void StartPhotos(int id) { CancelEdit(); _photosId = id; }
    private bool GetSet(int n) => n switch { 1 => _editing!.InSet1, 2 => _editing!.InSet2, 3 => _editing!.InSet3, 4 => _editing!.InSet4, 5 => _editing!.InSet5, 6 => _editing!.InSet6, _ => false };
    private void SetSet(int n, bool value)
    {
        if (_editing is null) return;
        switch (n) { case 1: _editing.InSet1 = value; break; case 2: _editing.InSet2 = value; break; case 3: _editing.InSet3 = value; break; case 4: _editing.InSet4 = value; break; case 5: _editing.InSet5 = value; break; case 6: _editing.InSet6 = value; break; }
    }
    private async Task SaveAsync()
    {
        if (_busy || _editing is null) return;
        if (!_editing.IsPublished) _editing.IsForSale = false;
        _busy = true; _savingProgress = L["Saving card details..."];
        CardDto? saved = null;
        var ct = _life.Token;
        try
        {
            var creating = _editingId is null;
            var result = creating ? await Api.CreateCardAsync(_editing) : await Api.UpdateCardAsync(_editingId!.Value, _editing);
            if (!result.Ok || result.Value is null) { Notify(result.Error ?? "The card couldn’t be saved. Please try again.", true); return; }
            saved = result.Value;
            string? uploadError = null;
            // Keep InputFile mounted until all selected streams have been read.
            for (var i = 0; i < _selectedPhotos.Count; i++)
            {
                _savingProgress = L.Format("Uploading photo {0} of {1}", i + 1, _selectedPhotos.Count);
                StateHasChanged();
                var upload = await Api.UploadPhotoAsync(saved.Id, _selectedPhotos[i], "", ct);
                if (!upload.Ok) { uploadError = upload.Error ?? "The photograph could not be uploaded."; break; }
            }
            CancelEdit();
            _photosId = saved.Id;
            if (creating) _page = 1;
            Notify(uploadError is null ? "Card saved. Review its photos and publish when ready." : L["Card saved. Some photos could not be uploaded."] + " " + L[uploadError], uploadError is not null);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or IOException or InvalidOperationException)
        {
            if (saved is not null) { CancelEdit(); _photosId = saved.Id; Notify("Card saved. Some photos could not be uploaded. Check saved photos before retrying.", true); }
            else Notify("We couldn’t confirm that your changes were saved. Refresh the inventory before trying again.", true);
        }
        finally { _busy = false; _savingProgress = ""; }
    }
    private async Task ConfirmAsync(CardDto card, bool delete)
    {
        if (_busy) return;
        _pending = card; _deletePending = delete; StateHasChanged();
        if (_confirmation is not null) await _confirmation.OpenAsync();
    }
    private async Task ApplyConfirmedAsync()
    {
        if (_busy || _pending is null) return;
        _busy = true; var card = _pending;
        try
        {
            if (_confirmation is not null) await _confirmation.CloseAsync();
            if (_deletePending) { var result = await Api.DeleteCardAsync(card.Id); if (!result.Ok) { Notify(result.Error ?? "The change could not be saved.", true); return; } }
            else { var result = await Api.SellCardAsync(card.Id, new SellRequest { SoldPrice = card.Price }); if (!result.Ok) { Notify(result.Error ?? "The change could not be saved.", true); return; } }
            if (_editingId == card.Id) CancelEdit();
            if (_photosId == card.Id) _photosId = null;
            await LoadAsync(); Notify("Inventory updated.", false);
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { Notify("We couldn’t complete that change. Please try again.", true); }
        finally { _busy = false; _pending = null; }
    }
    private void Notify(string message, bool error) { _message = message; _isError = error; }
    public override void Dispose() { _life.Cancel(); _life.Dispose(); _load?.Cancel(); _load?.Dispose(); base.Dispose(); }
}
