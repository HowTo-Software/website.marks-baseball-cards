@page "/marketplace"
<PageTitle>@L["Marketplace — Mark’s Baseball Cards"]</PageTitle>
<LiveCatalog Market="true" InitialSearch="@(Search ?? CardNumber ?? "")" />
@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "card")] public string? CardNumber { get; set; }
}
