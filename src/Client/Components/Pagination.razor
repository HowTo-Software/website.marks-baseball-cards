<nav class="catalog-pagination" aria-label="@L["Pagination"]">
    <button class="button button-outline button-small" disabled="@(Busy || Page <= 1)" @onclick="() => Changed.InvokeAsync(Page - 1)">@L["Previous"]</button>
    <span role="status">@L.Format("Page {0} of {1}", Page, Math.Max(1, Pages)) · @Total @L["records"]</span>
    <button class="button button-outline button-small" disabled="@(Busy || Page >= Pages)" @onclick="() => Changed.InvokeAsync(Page + 1)">@L["Next"]</button>
</nav>
@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int Pages { get; set; } = 1;
    [Parameter] public int Total { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<int> Changed { get; set; }
}
