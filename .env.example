# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. ".env" is gitignored.
# Do NOT wrap values in quotes - Docker Compose reads them literally.
# ----------------------------------------------------------------------------

# T-SQL connection to your existing SQL Server at 192.168.1.212.
# Apply the reviewed SQL script with a separate deployment account. The website
# uses a least-privilege application login, never sa. Use a trusted SQL TLS certificate.
ConnectionStrings__Default=Server=SQLSERVER_HOST,1433;Database=Website_Application_MarksBaseballCardsDb;User Id=marks_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False;Connect Timeout=5;Pooling=True;Max Pool Size=50

# Normal web startup does NOT run migrations, reset staff passwords or seed demo data.
Database__InitializeOnStartup=false
# Inside the container this path is backed by the card_photos persistent volume.
Photos__RootPath=/data/card-photos
PublicBaseUrl=https://marks-baseballcards.com
AllowedHosts=marks-baseballcards.com;localhost
# Configure the actual trusted proxy address; never trust arbitrary forwarded headers.
#ReverseProxy__KnownProxies__0=YOUR_PROXY_IP

# JWT signing - use a long random secret (>= 32 chars). Generate one, e.g.:
#   openssl rand -base64 48
Jwt__Key=CHANGE_ME_to_a_long_random_secret_at_least_32_characters
Jwt__Issuer=MarksBaseballCards
Jwt__Audience=MarksBaseballCardsUsers

# Initial admin accounts (created only by explicit database initialization).
Seed__AdminPassword=CHANGE_ME_admin_password
Seed__SystemAdminPassword=CHANGE_ME_system_password
# For a single email-based Admin account, use tools/MarksBaseballCards.AdminBootstrap instead.
# It generates a protected SQL file with a salted hash, without storing a plaintext password.

# Managed staff accounts (optional, repeatable by index 0,1,2,...).
# Reconciled only during explicit database initialization: created if missing, otherwise password/role are
# updated to match these values. This is also how you rotate a staff password.
# Role = Admin or SystemAdmin. Entries with a blank password are skipped.
#Seed__StaffUsers__0__Username=person@example.com
#Seed__StaffUsers__0__Role=Admin
#Seed__StaffUsers__0__Password=CHANGE_ME_strong_password

# Stripe (test keys are fine to start). Leave blank to disable online buying.
Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=
Stripe__Currency=usd
